# =================================================================
# HireShield AI - Environment Configuration Example
# =================================================================

# Server Settings
PROJECT_NAME="HireShield AI"
PROJECT_TAGLINE="Verify the opportunity. Understand the risk. Apply with confidence."
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & Authentication (Change in production!)
SECRET_KEY="replace-with-a-random-64-character-hex-secret-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local Development (Zero-setup SQLite):
DATABASE_URL="sqlite:///./hireshield.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://hireshield_user:hireshield_password_2026@localhost:5432/hireshield_db"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Public API URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
